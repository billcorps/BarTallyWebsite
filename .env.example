# These VITE_ values are public website content, never secrets.
VITE_BASE_PATH=/BarTallyWebsite/
VITE_SITE_URL=https://billcorps.github.io/BarTallyWebsite/

# Public name defaults to site-defaults.json; override only when needed.
VITE_DEVELOPER_NAME=William Haggerty

# Optional direct website contact. Leave blank to use the live Play listing's App support.
VITE_SUPPORT_EMAIL=

# Keep blank until the listing is live and App support provides a monitored private contact.
# Google Play itself requires a support email, even when it is not printed on this website.
VITE_PLAY_STORE_URL=

# Optional: defaults to VITE_SITE_URL + images/social-card.png.
VITE_SOCIAL_IMAGE=
