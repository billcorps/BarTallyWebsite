{
  "name": "bartally-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts tsconfig.json package.json site-defaults.json \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts tsconfig.json package.json site-defaults.json \"scripts/**/*.mjs\"",
    "build": "npm run typecheck && node scripts/build.mjs && npm run test:build",
    "check": "npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test:build": "node scripts/check-build.mjs",
    "test:e2e": "playwright test",
    "check:publish": "node scripts/check-publish.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
